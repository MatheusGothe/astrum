# Google Play listing link; app install is performed in the emulator.
ASTRUM_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=app.astrum.mobile&hl=pt_BR
# Astrum test configuration. Signup email/password are generated per run.
ASTRUM_APP_ID=app.astrum.mobile
ASTRUM_TEST_NAME=Astrum QA
# Google Play account. Keep real values in GitHub Actions secrets or a local untracked .env.
PLAY_STORE_EMAIL=
PLAY_STORE_PASSWORD=
